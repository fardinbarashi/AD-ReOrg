<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AD ReOrg" Height="900" Width="1480" MinHeight="600" MinWidth="1040"
        WindowStartupLocation="CenterScreen" Background="#EEF1F5"
        FontFamily="Segoe UI" FontSize="13">
  <!-- Window icon: a PowerShell-style prompt on a Windows-blue tile -->
  <Window.Icon>
    <DrawingImage>
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#0078D4" Geometry="M3,0 H29 A3,3 0 0 1 32,3 V29 A3,3 0 0 1 29,32 H3 A3,3 0 0 1 0,29 V3 A3,3 0 0 1 3,0 Z"/>
          <GeometryDrawing Geometry="M7,9 L15,16 L7,23 M17,24 H25">
            <GeometryDrawing.Pen><Pen Brush="White" Thickness="3.2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
  </Window.Icon>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V"/>
    <SolidColorBrush x:Key="Blue"   Color="#1E76BE"/>
    <SolidColorBrush x:Key="Green"  Color="#1B7A3D"/>
    <SolidColorBrush x:Key="Line"   Color="#DDE3EA"/>
    <SolidColorBrush x:Key="Muted"  Color="#5B6472"/>
    <SolidColorBrush x:Key="Ink"    Color="#1F2933"/>
    <SolidColorBrush x:Key="Navy"   Color="#1C2B3A"/>

    <!-- Cards -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14"/>
    </Style>
    <!-- Action bar: the same place (bottom) and look in every tool -->
    <Style x:Key="ActionBar" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>

    <!-- Buttons: one size everywhere -->
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="MinWidth" Value="120"/>
      <Setter Property="Background" Value="{StaticResource Blue}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Green}"/>
      <Setter Property="MinWidth" Value="170"/>
    </Style>
    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#E6EBF1"/>
      <Setter Property="Foreground" Value="#26313D"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#3B4754"/>
      <Setter Property="BorderBrush" Value="#D5DCE4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <!-- Caret half of a split "Export" button -->
    <Style x:Key="Caret" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Width" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="2,0,0,0"/>
      <Setter Property="ToolTip" Value="Export one format only"/>
    </Style>

    <!-- Toggle buttons (help, OU picker, log) -->
    <Style x:Key="Toggle" TargetType="ToggleButton">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="#E6EBF1"/>
      <Setter Property="Foreground" Value="#26313D"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="#D5E6F6"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Sidebar navigation -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Nav"/>
      <Setter Property="Foreground" Value="#C9D6E3"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="14,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#26394C"/><Setter Property="Foreground" Value="White"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2B4A66"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#5FB0F0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavSection" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#9FB3C8"/>
      <Setter Property="Margin" Value="16,16,0,6"/>
    </Style>

    <!-- Segmented choice (Compare groups/users, Changes/Attributes) -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#26313D"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="White" BorderBrush="#CBD3DD" BorderThickness="1" CornerRadius="8" Padding="14,0" Margin="0,0,4,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1E76BE"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E76BE"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- WhatIf switch: amber = simulation, red = live -->
    <Style x:Key="WhatIf" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Content" Value="LIVE - writes to Active Directory"/>
      <Setter Property="Foreground" Value="#9B1C1C"/>
      <Setter Property="ToolTip" Value="Checked: simulation, nothing is written. Clear it for a live run."/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Bd" Background="#FDE8E8" CornerRadius="8" Padding="10,0" Height="36">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="18" Height="18" CornerRadius="4" Background="White" BorderBrush="#9AA4B0" BorderThickness="1" Margin="0,0,8,0">
                  <Path x:Name="Tick" Data="M3.5,9 L7.5,13 L14.5,5" Stroke="#7A5A00" StrokeThickness="2.2" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFF4D6"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Content" Value="WhatIf - simulation"/>
          <Setter Property="Foreground" Value="#7A5A00"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Text boxes: rounded, with a grey placeholder taken from Tag -->
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#CBD3DD"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <Grid>
                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                <TextBlock x:Name="Ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="#8A94A3" Margin="{TemplateBinding Padding}" Padding="3,0,0,0"
                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value=""><Setter TargetName="Ph" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#1E76BE"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center"/></Style>

    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#4B5563"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- Data grids -->
    <Style TargetType="DataGrid">
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F5"/>
      <Setter Property="AlternatingRowBackground" Value="#F9FAFC"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="RowHeight" Value="28"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#F5F7FA"/>
      <Setter Property="Foreground" Value="#374151"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style TargetType="TreeView">
      <Setter Property="BorderBrush" Value="#E5EAF0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="4"/>
    </Style>

    <!-- Hidden tab headers: the sidebar picks the tool -->
    <Style x:Key="HiddenTab" TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style>
    <!-- Snapshot stepper headers -->
    <Style x:Key="StepTab" TargetType="TabItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,10,12" MinWidth="230">
              <ContentPresenter ContentSource="Header"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E3EEF9"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E76BE"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Icon geometry -->
    <Geometry x:Key="IcoAll">M3,3 H21 V21 H3 Z M8,12 L11,15 L16,9</Geometry>
    <Geometry x:Key="IcoNone">M3,3 H21 V21 H3 Z</Geometry>
    <Geometry x:Key="IcoExpand">M7,9 L12,14 L17,9</Geometry>
    <Geometry x:Key="IcoCollapse">M7,15 L12,10 L17,15</Geometry>
    <Geometry x:Key="IcoCaret">M7,10 L12,15 L17,10</Geometry>
    <Geometry x:Key="IcoInfo">M12,3 A9,9 0 1 1 11.99,3 Z M12,11 V17 M12,7.5 V8</Geometry>
  </Window.Resources>

  <DockPanel>
    <!-- ================= TOP BAR ================= -->
    <Border DockPanel.Dock="Top" Background="#16232F" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="36" Height="36" CornerRadius="6" Background="#0078D4" Margin="0,0,12,0" ToolTip="AD ReOrg">
            <Path Data="M7.5,9 L15,16 L7.5,23 M17,24 H26" Stroke="White" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Width="36" Height="36" Stretch="None" Margin="0,-2,0,0"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="AD ReOrg" Foreground="White" FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="TagLineText" Text="Active Directory reorganisation toolkit" Foreground="#9FB3C8" FontSize="12"/>
          </StackPanel>
        </StackPanel>
        <Grid Grid.Column="1" Margin="28,0,16,0" VerticalAlignment="Center" MaxWidth="620" HorizontalAlignment="Stretch">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Root" Foreground="#9FB3C8" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox Grid.Column="1" x:Name="TxtRoot" Background="#22344A" Foreground="White" BorderBrush="#33485F" CaretBrush="White"
                   Tag="SearchBase, for example OU=Company,DC=corp,DC=local" ToolTip="SearchBase - the OU (or domain) AD ReOrg reads. Press Enter to connect."/>
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#22344A" CornerRadius="16" Padding="12,0" Height="32" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse x:Name="DotConn" Width="8" Height="8" Fill="#F59E0B" Margin="0,0,8,0"/>
              <TextBlock x:Name="SubtitleText" Text="Not connected" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Button x:Name="BtnConnect" Content="Connect &amp; load AD" Style="{StaticResource Primary}" Margin="0,0,8,0"/>
          <Button x:Name="BtnReload" Content="Reload" Style="{StaticResource Ghost}" MinWidth="90" Background="#22344A" Foreground="White"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= STATUS BAR + LOG ================= -->
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,4">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ToggleButton Grid.Column="0" x:Name="TglLog" Style="{StaticResource Toggle}" Height="28" Margin="0,0,12,0" ToolTip="Show or hide the log">
          <StackPanel Orientation="Horizontal">
            <Path Data="M4,6 H20 M4,12 H20 M4,18 H14" Stroke="#26313D" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform" Margin="0,0,6,0"/>
            <TextBlock Text="Log" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
        <TextBlock Grid.Column="1" x:Name="TxtStatus" Text="Ready. Enter a root and click Connect &amp; load AD." VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
        <ProgressBar Grid.Column="2" x:Name="Pb" Width="220" Height="12" Visibility="Collapsed"/>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" x:Name="BrdLog" Background="#0F2233" Height="150" Padding="12,8"
            Visibility="{Binding IsChecked, ElementName=TglLog, Converter={StaticResource B2V}}">
      <TextBox x:Name="LogBox" Style="{x:Null}" IsReadOnly="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               Background="#0F2233" Foreground="#A7F3D0" BorderThickness="0" FontFamily="Consolas" FontSize="12"/>
    </Border>

    <!-- ================= SIDEBAR ================= -->
    <Border DockPanel.Dock="Left" Background="{StaticResource Navy}" Width="218" Padding="8,4,8,12">
      <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="Reports are saved under files\" Foreground="#9FB3C8" FontSize="11" Margin="12,0,0,0" TextWrapping="Wrap"/>
        <StackPanel>
          <TextBlock Text="GROUPS" Style="{StaticResource NavSection}"/>
          <RadioButton x:Name="NavCreate"  Style="{StaticResource Nav}" Content="Create groups" IsChecked="True"/>
          <RadioButton x:Name="NavRename"  Style="{StaticResource Nav}" Content="Rename groups"/>
          <RadioButton x:Name="NavUpdate"  Style="{StaticResource Nav}" Content="Update attributes"/>
          <RadioButton x:Name="NavCopy"    Style="{StaticResource Nav}" Content="Copy members"/>
          <TextBlock Text="COMPARE" Style="{StaticResource NavSection}"/>
          <RadioButton x:Name="NavCompare" Style="{StaticResource Nav}" Content="Compare groups / users"/>
          <TextBlock Text="SNAPSHOTS" Style="{StaticResource NavSection}"/>
          <RadioButton x:Name="NavSnapUsers"  Style="{StaticResource Nav}" Content="Snapshot users"/>
          <RadioButton x:Name="NavSnapGroups" Style="{StaticResource Nav}" Content="Snapshot groups"/>
          <TextBlock Text="ENVIRONMENT" Style="{StaticResource NavSection}"/>
          <RadioButton x:Name="NavOu"     Style="{StaticResource Nav}" Content="OU structure"/>
          <RadioButton x:Name="NavSchema" Style="{StaticResource Nav}" Content="Schema attributes"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ================= CONTENT ================= -->
    <Grid Margin="16,14,16,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Tool header -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
        <TextBlock x:Name="TxtToolTitle" Text="Create groups" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        <ToggleButton x:Name="BtnHelp" Style="{StaticResource Toggle}" Width="28" Height="28" Padding="0" Margin="10,0,10,0" ToolTip="How this tool works">
          <Path Data="{StaticResource IcoInfo}" Stroke="#1E76BE" StrokeThickness="2" Width="16" Height="16" Stretch="Uniform"/>
        </ToggleButton>
        <TextBlock x:Name="TxtToolSub" Text="" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
      </StackPanel>
      <Border Grid.Row="1" x:Name="BrdHelp" Background="#E8F1FB" BorderBrush="#BBD5EF" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,12"
              Visibility="{Binding IsChecked, ElementName=BtnHelp, Converter={StaticResource B2V}}">
        <TextBlock x:Name="TxtHelp" TextWrapping="Wrap" Foreground="#183B5C" LineHeight="19"/>
      </Border>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- ===== Shared selection: one tree for Create, Rename, Update and Analyse ===== -->
        <Border Grid.Column="0" x:Name="SelPane" Style="{StaticResource Card}" Width="330" Margin="0,0,12,0" Padding="12">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Selected groups" Style="{StaticResource H2}"/>
              <Border Grid.Column="1" Background="#E3EEF9" CornerRadius="10" Padding="9,2">
                <TextBlock x:Name="TxtSelCount" Text="0" Foreground="#0F4C81" FontWeight="SemiBold"/>
              </Border>
            </Grid>
            <TextBox DockPanel.Dock="Top" x:Name="TxtSelFilter" Tag="Filter by name..." Margin="0,0,0,6"/>
            <Expander DockPanel.Dock="Top" x:Name="ExpSelAttr" Header="Attribute filter" Margin="0,0,0,8"
                      ToolTip="Fill 1-3 pairs (AD attribute + text the value must contain). A group must match all filled pairs. Leave Value empty to match any group that has the attribute.">
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBox Grid.Row="0" Grid.Column="0" x:Name="TxtSelAttr1" Tag="AD-attribute" Margin="0,0,0,4"/>
                <TextBox Grid.Row="0" Grid.Column="2" x:Name="TxtSelVal1"  Tag="Value" Margin="0,0,0,4"/>
                <TextBox Grid.Row="1" Grid.Column="0" x:Name="TxtSelAttr2" Tag="AD-attribute" Margin="0,0,0,4"/>
                <TextBox Grid.Row="1" Grid.Column="2" x:Name="TxtSelVal2"  Tag="Value" Margin="0,0,0,4"/>
                <TextBox Grid.Row="2" Grid.Column="0" x:Name="TxtSelAttr3" Tag="AD-attribute"/>
                <TextBox Grid.Row="2" Grid.Column="2" x:Name="TxtSelVal3"  Tag="Value"/>
              </Grid>
            </Expander>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
              <Button x:Name="BtnSelAll"      Style="{StaticResource IconBtn}" ToolTip="Select all"><Path Data="{StaticResource IcoAll}" Stroke="#3B4754" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/></Button>
              <Button x:Name="BtnSelNone"     Style="{StaticResource IconBtn}" ToolTip="Clear the selection"><Path Data="{StaticResource IcoNone}" Stroke="#3B4754" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/></Button>
              <Button x:Name="BtnSelExpand"   Style="{StaticResource IconBtn}" ToolTip="Expand all"><Path Data="{StaticResource IcoExpand}" Stroke="#3B4754" StrokeThickness="2" Width="14" Height="10" Stretch="Uniform"/></Button>
              <Button x:Name="BtnSelCollapse" Style="{StaticResource IconBtn}" ToolTip="Collapse all"><Path Data="{StaticResource IcoCollapse}" Stroke="#3B4754" StrokeThickness="2" Width="14" Height="10" Stretch="Uniform"/></Button>
              <TextBlock Text="shared by the group tools" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
            <TreeView x:Name="SelTree" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ToolTip="(U) users · (C) computers · (G) groups · red text = member of other groups"/>
          </DockPanel>
        </Border>

        <!-- ===== Tools (headers hidden - the sidebar picks one) ===== -->
        <TabControl Grid.Column="1" x:Name="ToolTabs" BorderThickness="0" Background="Transparent" Padding="0" ItemContainerStyle="{StaticResource HiddenTab}">

          <!-- ================= 0: CREATE GROUPS ================= -->
          <TabItem Header="Create">
            <DockPanel>
              <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox x:Name="ChkWhatIf" Style="{StaticResource WhatIf}" IsChecked="True" Margin="0,0,10,0"/>
                    <Button x:Name="BtnCreate" Content="Create groups" Style="{StaticResource Primary}"/>
                  </StackPanel>
                  <TextBlock x:Name="TxtPreviewCount" Text="Groups to create: 0 of 0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
              <Grid x:Name="GrdCreate">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="170"/></Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" x:Name="ScvCreateOpts" VerticalScrollBarVisibility="Auto" MaxHeight="470" Margin="0,0,0,12">
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <!-- Target -->
                      <TextBlock Text="Target OU (or group for 'copy to existing only')" Style="{StaticResource Lbl}"/>
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Background="#F5F7FA" BorderBrush="#CBD3DD" BorderThickness="1" CornerRadius="6" Padding="10,0" MinHeight="32">
                          <TextBlock x:Name="TxtTargetOu" Text="(no target selected)" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <ToggleButton Grid.Column="1" x:Name="TglOuPicker" Style="{StaticResource Toggle}" Content="Choose..." Margin="8,0,0,0" MinWidth="110"/>
                      </Grid>
                      <Border x:Name="PnlOuPicker" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12"
                              Visibility="{Binding IsChecked, ElementName=TglOuPicker, Converter={StaticResource B2V}}">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Top" Text="Create: click an OU. Copy to existing only: click a group (bold = OU, plain = group)." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"/>
                          <TextBox DockPanel.Dock="Top" x:Name="TxtTargetFilter" Tag="Filter OUs..." Margin="0,0,0,6"/>
                          <TreeView x:Name="OuTree" Height="230" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                        </DockPanel>
                      </Border>
                      <!-- Names -->
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                          <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Text="Find in name" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtFind" Tag="e.g. OLD" ToolTip="Not case-sensitive. A replacement typed in lower case keeps the case of each hit: ceasar -&gt; beasar turns Ceasar A into Beasar A. Type a capital letter in the replacement to use it exactly as typed."/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Replace with" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtReplace" Tag="e.g. NEW"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="Prefix" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtPrefix"/></StackPanel>
                        <StackPanel Grid.Column="6"><TextBlock Text="Suffix" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtSuffix"/></StackPanel>
                        <StackPanel Grid.Column="8"><TextBlock Text="sAM suffix" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtSamSuffix" Tag="e.g. _NEW" ToolTip="Gives identical names a unique sAMAccountName."/></StackPanel>
                      </Grid>
                      <CheckBox x:Name="ChkRegex" Content="Find is a regular expression" Margin="0,0,0,10"/>
                      <!-- Copy -->
                      <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="Copy from the source" Style="{StaticResource Lbl}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <CheckBox x:Name="ChkCopyUsers"     Content="Users"     Margin="0,0,14,0"/>
                        <CheckBox x:Name="ChkCopyGroups"    Content="Groups"    Margin="0,0,14,0"/>
                        <CheckBox x:Name="ChkCopyComputers" Content="Computers" Margin="0,0,14,0"/>
                        <CheckBox x:Name="ChkCopyMemberOf"  Content="memberOf"  Margin="0,0,14,0" ToolTip="The new group joins the same groups as the source."/>
                        <CheckBox x:Name="ChkNest"          Content="Nest new in source" Margin="0,0,14,0" ToolTip="Adds the new group as a member of the source (inherits its permissions)."/>
                        <CheckBox x:Name="ChkOnlyExisting"  Content="Copy to existing groups only" FontWeight="SemiBold" ToolTip="Nothing is created - members are copied to the target group."/>
                      </WrapPanel>
                      <Expander Header="Description, notes, scope, category and attributes to copy">
                        <StackPanel Margin="0,8,0,0">
                          <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                              <TextBlock Text="Description (description)" Style="{StaticResource Lbl}"/>
                              <TextBox x:Name="TxtDescription" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" VerticalContentAlignment="Top" Padding="8,6" VerticalScrollBarVisibility="Auto"/>
                              <TextBlock x:Name="TxtDescHint" Foreground="#B4232A" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>
                              <WrapPanel Margin="0,6,0,0">
                                <CheckBox x:Name="ChkCopyDesc"    Content="Copy"         IsChecked="True" Margin="0,0,14,0"/>
                                <CheckBox x:Name="ChkAddDesc"     Content="Add"          Margin="0,0,14,0"/>
                                <CheckBox x:Name="ChkCopyAddDesc" Content="Copy and add"/>
                              </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                              <TextBlock Text="Notes (info)" Style="{StaticResource Lbl}"/>
                              <TextBox x:Name="TxtNotes" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" VerticalContentAlignment="Top" Padding="8,6" VerticalScrollBarVisibility="Auto"/>
                              <TextBlock x:Name="TxtNotesHint" Foreground="#B4232A" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>
                              <WrapPanel Margin="0,6,0,0">
                                <CheckBox x:Name="ChkCopyNotes"    Content="Copy"         IsChecked="True" Margin="0,0,14,0"/>
                                <CheckBox x:Name="ChkAddNotes"     Content="Add"          Margin="0,0,14,0"/>
                                <CheckBox x:Name="ChkCopyAddNotes" Content="Copy and add"/>
                              </WrapPanel>
                            </StackPanel>
                          </Grid>
                          <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="Scope" Style="{StaticResource Lbl}"/><ComboBox x:Name="CmbScope" SelectedIndex="0"><ComboBoxItem Content="Global"/><ComboBoxItem Content="DomainLocal"/><ComboBoxItem Content="Universal"/></ComboBox></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Category" Style="{StaticResource Lbl}"/><ComboBox x:Name="CmbCategory" SelectedIndex="0"><ComboBoxItem Content="Security"/><ComboBoxItem Content="Distribution"/></ComboBox></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Attributes to copy" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtCopyAttrs" Tag="e.g. url, extensionAttribute1"
                                        ToolTip="One or more attribute names, separated by comma, semicolon or space. Copied from every source group to its new group (multi-valued attributes like url are merged)."/></StackPanel>
                          </Grid>
                          <CheckBox x:Name="ChkContinueOnError" Content="Continue on errors - create what works, list the failures in a separate report"/>
                        </StackPanel>
                      </Expander>
                    </StackPanel>
                  </Border>
                </ScrollViewer>
                <Border Grid.Row="1" Style="{StaticResource Card}">
                  <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnApplyPattern" Content="Recalculate names" Style="{StaticResource Ghost}" Margin="0,0,8,0" MinWidth="150"/>
                        <Button x:Name="BtnBuildPreview" Content="Build preview" MinWidth="150"/>
                      </StackPanel>
                      <TextBlock Text="Preview - New name and New sAM can be edited" Style="{StaticResource H2}"/>
                    </DockPanel>
                    <DataGrid x:Name="GridPreview" AutoGenerateColumns="False" CanUserAddRows="False">
                      <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Inc." Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="42"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Source group" Binding="{Binding SourceName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="New name" Binding="{Binding NewName, UpdateSourceTrigger=LostFocus}" Width="*"/>
                        <DataGridTextColumn Header="New sAM" Binding="{Binding NewSam, UpdateSourceTrigger=LostFocus}" Width="160"/>
                        <DataGridTextColumn Header="Members" Binding="{Binding MemberCount}" Width="70" IsReadOnly="True"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </DockPanel>
                </Border>
              </Grid>
            </DockPanel>
          </TabItem>

          <!-- ================= 1: RENAME GROUPS ================= -->
          <TabItem Header="Rename">
            <DockPanel>
              <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnRenCheck" Content="Check in AD" Style="{StaticResource Ghost}" Margin="0,0,10,0" MinWidth="140"
                            ToolTip="Reads AD without changing anything: new sAMAccountName free in the domain, new name free in the OU, max 64 characters, not renamed since the preview."/>
                    <CheckBox x:Name="ChkRenWhatIf" Style="{StaticResource WhatIf}" IsChecked="True" Margin="0,0,10,0"/>
                    <Button x:Name="BtnRenApply" Content="Rename groups" Style="{StaticResource Primary}"/>
                  </StackPanel>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtRenCount" Text="No preview built yet." FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtRenResult" Text="" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <Grid x:Name="GrdRename">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="170"/></Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" x:Name="ScvRenameOpts" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0"><TextBlock Text="Find" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtRenFind" Tag="e.g. OLD-" ToolTip="Not case-sensitive. A replacement typed in lower case keeps the case of each hit: ceasar -&gt; beasar turns Ceasar A into Beasar A. Type a capital letter in the replacement to use it exactly as typed."/></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Text="Replace with" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtRenReplace" Tag="e.g. NEW- (empty removes the text)"/></StackPanel>
                      <CheckBox Grid.Column="4" x:Name="ChkRenRegex" Content="Regular expression" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                ToolTip="Cleared: Find is literal text, case-insensitive. Checked: Find is a .NET regular expression and Replace may use $1, $2 ..."/>
                    </Grid>
                    <WrapPanel Margin="0,0,0,8">
                      <TextBlock Text="Apply to" Style="{StaticResource Lbl}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                      <CheckBox x:Name="ChkRenName"    Content="Name (CN)"      IsChecked="True" Margin="0,0,14,0" ToolTip="The object name - also changes the DN. Max 64 characters, unique within the OU."/>
                      <CheckBox x:Name="ChkRenSam"     Content="sAMAccountName" IsChecked="True" Margin="0,0,14,0" ToolTip="Must be unique in the whole domain."/>
                      <CheckBox x:Name="ChkRenDisplay" Content="displayName"    IsChecked="True" ToolTip="Only groups that already have a displayName are changed."/>
                    </WrapPanel>
                    <Expander Header="More - prefix, suffix and description" Margin="0,0,0,10">
                      <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0"><TextBlock Text="Prefix" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtRenPrefix" ToolTip="Not added again when the value already starts with it."/></StackPanel>
                          <StackPanel Grid.Column="2"><TextBlock Text="Suffix" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtRenSuffix" ToolTip="Not added again when the value already ends with it."/></StackPanel>
                        </Grid>
                        <TextBlock Text="Add to description" Style="{StaticResource Lbl}"/>
                        <Grid Margin="0,0,0,6">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBox Grid.Column="0" x:Name="TxtRenDescAdd" Tag="Optional, e.g. Renamed 2026-10 (was OLD-Sales)" ToolTip="Not added again when the description already contains it."/>
                          <ComboBox Grid.Column="2" x:Name="CmbRenDescPos" SelectedIndex="0" Width="110"><ComboBoxItem Content="At the end"/><ComboBoxItem Content="At the start"/></ComboBox>
                          <CheckBox Grid.Column="4" x:Name="ChkRenDescNoSep" Content="No separator" Margin="0,0,8,0"/>
                          <TextBox Grid.Column="5" x:Name="TxtRenDescSep" Width="60" Text="; " ToolTip="Separator between the existing description and the added text."/>
                        </Grid>
                        <CheckBox x:Name="ChkRenDescFind" Content="Also use Find -> Replace on the description (prefix and suffix are not added to it)"/>
                      </StackPanel>
                    </Expander>
                    <StackPanel Orientation="Horizontal">
                      <Button x:Name="BtnRenPreview" Content="Build preview" MinWidth="160" Margin="0,0,8,0" ToolTip="Reads the selected groups from AD and computes the new values."/>
                      <Button x:Name="BtnRenRecalc"  Content="Recalculate"   Style="{StaticResource Ghost}" MinWidth="160" Margin="0,0,8,0" ToolTip="Applies the current rule again to the rows in the preview (manual edits are overwritten)."/>
                      <Button x:Name="BtnRenRevert"  Content="Revert from report..." Style="{StaticResource Ghost}" MinWidth="160"
                              ToolTip="Open a rename_groups_*.json (or .csv) from files\rename-groups: the groups it renamed are loaded with their old values as the target."/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                </ScrollViewer>
                <Border Grid.Row="1" Style="{StaticResource Card}">
                  <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox x:Name="ChkRenShowChanged" Content="Groups that change" IsChecked="True" Margin="0,0,14,0"/>
                        <CheckBox x:Name="ChkRenShowSame"    Content="Groups that will not change" Margin="0,0,16,0" ToolTip="Selected groups the rule does not match (No change). They are never renamed."/>
                        <Button x:Name="BtnRenRowsAll"  Style="{StaticResource IconBtn}" ToolTip="Check all rows"><Path Data="{StaticResource IcoAll}" Stroke="#3B4754" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/></Button>
                        <Button x:Name="BtnRenRowsNone" Style="{StaticResource IconBtn}" ToolTip="Uncheck all rows" Margin="0"><Path Data="{StaticResource IcoNone}" Stroke="#3B4754" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/></Button>
                      </StackPanel>
                      <TextBlock Text="Preview - the New columns can be edited" Style="{StaticResource H2}"/>
                    </DockPanel>
                    <Border DockPanel.Dock="Top" x:Name="BrdRenMode" Visibility="Collapsed" Background="#FFF4D6" BorderBrush="#E8B931" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                      <TextBlock x:Name="TxtRenMode" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#7A5A00"/>
                    </Border>
                    <DataGrid x:Name="GridRename" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                      <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Inc." Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" IsReadOnly="True">
                          <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Status}"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Current name" Binding="{Binding OldName}" Width="180" IsReadOnly="True">
                          <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding OldDN}"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="New name" Binding="{Binding NewName, UpdateSourceTrigger=LostFocus}" Width="180">
                          <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Current sAM"         Binding="{Binding OldSam}"     Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="New sAM"             Binding="{Binding NewSam, UpdateSourceTrigger=LostFocus}"     Width="150"/>
                        <DataGridTextColumn Header="Current displayName" Binding="{Binding OldDisplay}" Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="New displayName"     Binding="{Binding NewDisplay, UpdateSourceTrigger=LostFocus}" Width="140"/>
                        <DataGridTextColumn Header="Current description" Binding="{Binding OldDesc}"    Width="180" IsReadOnly="True">
                          <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding OldDesc}"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="New description"     Binding="{Binding NewDesc, UpdateSourceTrigger=LostFocus}"    Width="180">
                          <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding NewDesc}"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                  </DockPanel>
                </Border>
              </Grid>
            </DockPanel>
          </TabItem>

          <!-- ================= 2: UPDATE ATTRIBUTES (bulk + single merged) ================= -->
          <TabItem Header="Update">
            <DockPanel>
              <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox x:Name="ChkUrlWhatIf" Style="{StaticResource WhatIf}" IsChecked="True" Margin="0,0,10,0"/>
                    <Button x:Name="BtnUrlApply" Content="Apply changes" Style="{StaticResource Primary}"/>
                  </StackPanel>
                  <TextBlock x:Name="TxtUrlCount" Text="No scan run." FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </Border>
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="170"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                  <StackPanel>
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0"><TextBlock Text="AD-attribute" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtUrlAttr" Tag="e.g. url - or click a row under Attributes"/></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Text="Find" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtUrlSourceOu" Tag="e.g. OU=OLD,"/></StackPanel>
                      <StackPanel Grid.Column="4"><TextBlock Text="Replace with" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtUrlTargetOu" Tag="e.g. OU=NEW,"/></StackPanel>
                    </Grid>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" x:Name="BtnUrlScan" Content="Scan / preview" MinWidth="160"/>
                      <WrapPanel VerticalAlignment="Center">
                        <CheckBox x:Name="ChkUrlAddNew" Content="Add new value, keep old" IsChecked="True" Margin="0,0,16,0"
                                  ToolTip="Multi-valued attributes (url): the new value is added and the old one kept. Single-valued attributes (description): the new text is appended."/>
                        <CheckBox x:Name="ChkUrlReplaceOld" Content="Replace old value" Margin="0,0,20,0" ToolTip="The old value is removed and the new one written in its place."/>
                        <CheckBox x:Name="ChkUrlNoSep" Content="No separator" IsChecked="True" Margin="0,0,8,0" ToolTip="Used when a single-valued attribute gets text appended."/>
                        <TextBox x:Name="TxtUrlSep" Width="70" IsEnabled="False" Text="; " ToolTip="Separator between the old and the new text when appending."/>
                      </WrapPanel>
                    </DockPanel>
                  </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}">
                  <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                      <CheckBox DockPanel.Dock="Right" x:Name="ChkUrlNonEmpty" Content="Ignore empty attributes" IsChecked="True"
                                Visibility="{Binding IsChecked, ElementName=RbUpdAttrs, Converter={StaticResource B2V}}"
                                ToolTip="Checked: only attributes that hold a value. Clear it to list every attribute the schema allows for a group."/>
                      <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbUpdChanges" GroupName="UpdView" Style="{StaticResource Seg}" Content="Changes" IsChecked="True"/>
                        <RadioButton x:Name="RbUpdAttrs"   GroupName="UpdView" Style="{StaticResource Seg}" Content="Attributes of the first selected group"/>
                      </StackPanel>
                    </DockPanel>
                    <Grid>
                      <DataGrid x:Name="GridUrl" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                Visibility="{Binding IsChecked, ElementName=RbUpdChanges, Converter={StaticResource B2V}}">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                          <DataGridTextColumn Header="Current value (matched)" Binding="{Binding SourceUrl}" Width="*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding SourceUrl}"/></Style></DataGridTextColumn.ElementStyle>
                          </DataGridTextColumn>
                          <DataGridTextColumn Header="New value" Binding="{Binding NewUrl}" Width="*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding NewUrl}"/></Style></DataGridTextColumn.ElementStyle>
                          </DataGridTextColumn>
                        </DataGrid.Columns>
                      </DataGrid>
                      <DataGrid x:Name="GridUrlAttrs" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                Visibility="{Binding IsChecked, ElementName=RbUpdAttrs, Converter={StaticResource B2V}}"
                                ToolTip="Click a row to use that attribute">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Attribute" Binding="{Binding Attribute}" Width="220">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                          </DataGridTextColumn>
                          <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Value}"/></Style></DataGridTextColumn.ElementStyle>
                          </DataGridTextColumn>
                        </DataGrid.Columns>
                      </DataGrid>
                    </Grid>
                  </DockPanel>
                </Border>
              </Grid>
            </DockPanel>
          </TabItem>

          <!-- ================= 3: COPY MEMBERS ================= -->
          <TabItem Header="Copy">
            <DockPanel>
              <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox x:Name="ChkCMWhatIf" Style="{StaticResource WhatIf}" IsChecked="True" Margin="0,0,10,0"/>
                    <Button x:Name="BtnCMRun" Content="Copy members" Style="{StaticResource Primary}"/>
                  </StackPanel>
                  <TextBlock Text="Additive - existing members of the target are kept." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Click source, then target" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBox DockPanel.Dock="Top" x:Name="TxtCMFilter" Tag="Filter by name..." Margin="0,0,0,6"/>
                    <Expander DockPanel.Dock="Top" Header="Attribute filter" Margin="0,0,0,8">
                      <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBox Grid.Row="0" Grid.Column="0" x:Name="TxtCMAttr1" Tag="AD-attribute" Margin="0,0,0,4"/>
                        <TextBox Grid.Row="0" Grid.Column="2" x:Name="TxtCMVal1"  Tag="Value" Margin="0,0,0,4"/>
                        <TextBox Grid.Row="1" Grid.Column="0" x:Name="TxtCMAttr2" Tag="AD-attribute" Margin="0,0,0,4"/>
                        <TextBox Grid.Row="1" Grid.Column="2" x:Name="TxtCMVal2"  Tag="Value" Margin="0,0,0,4"/>
                        <TextBox Grid.Row="2" Grid.Column="0" x:Name="TxtCMAttr3" Tag="AD-attribute"/>
                        <TextBox Grid.Row="2" Grid.Column="2" x:Name="TxtCMVal3"  Tag="Value"/>
                      </Grid>
                    </Expander>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                      <Button x:Name="BtnCMClear"    Style="{StaticResource IconBtn}" ToolTip="Clear source and target"><Path Data="{StaticResource IcoNone}" Stroke="#3B4754" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/></Button>
                      <Button x:Name="BtnCMExpand"   Style="{StaticResource IconBtn}" ToolTip="Expand all"><Path Data="{StaticResource IcoExpand}" Stroke="#3B4754" StrokeThickness="2" Width="14" Height="10" Stretch="Uniform"/></Button>
                      <Button x:Name="BtnCMCollapse" Style="{StaticResource IconBtn}" ToolTip="Collapse all"><Path Data="{StaticResource IcoCollapse}" Stroke="#3B4754" StrokeThickness="2" Width="14" Height="10" Stretch="Uniform"/></Button>
                    </StackPanel>
                    <TreeView x:Name="CopyTree" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                  </DockPanel>
                </Border>
                <StackPanel Grid.Column="2">
                  <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="SOURCE" Style="{StaticResource Lbl}" Foreground="#0F4C81"/>
                        <TextBox x:Name="TxtCMSrcName" Tag="1st click in the tree, or type a name" ToolTip="You can also type a group name or sAMAccountName."/>
                        <TextBlock x:Name="TxtCMSrcInfo" Text="" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                      </StackPanel>
                      <Path Grid.Column="1" Data="M4,12 H20 M14,6 L20,12 L14,18" Stroke="#9AA4B0" StrokeThickness="2" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Top" Margin="0,26,0,0"/>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="TARGET" Style="{StaticResource Lbl}" Foreground="#145C2E"/>
                        <TextBox x:Name="TxtCMTgtName" Tag="2nd click in the tree, or type a name" ToolTip="You can also type a group name or sAMAccountName."/>
                        <TextBlock x:Name="TxtCMTgtInfo" Text="" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock Text="Member types to copy" Style="{StaticResource Lbl}"/>
                      <WrapPanel Margin="0,4,0,8">
                        <CheckBox x:Name="ChkCMUsers"     Content="Users"     IsChecked="True" Margin="0,0,16,0"/>
                        <CheckBox x:Name="ChkCMGroups"    Content="Groups"    IsChecked="True" Margin="0,0,16,0"/>
                        <CheckBox x:Name="ChkCMComputers" Content="Computers"/>
                      </WrapPanel>
                      <TextBlock Text="(U) users · (C) computers · (G) groups in the tree · red text = member of other groups. A member report (account + UPN) is written to files\copy-members." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </DockPanel>
          </TabItem>

          <!-- ================= 4: SNAPSHOT GROUPS (formerly Group analyser) ================= -->
          <TabItem Header="Analyse">
            <DockPanel>
              <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnAnalyseAll" Content="Export groups" Style="{StaticResource Primary}" ToolTip="HTML + CSV + JSON"/>
                    <Button x:Name="BtnAnalyseFmt" Style="{StaticResource Caret}" Background="{StaticResource Green}"><Path Data="{StaticResource IcoCaret}" Stroke="White" StrokeThickness="2.2" Width="12" Height="8" Stretch="Uniform"/></Button>
                  </StackPanel>
                  <TextBlock x:Name="TxtAnalyseCount" Text="Selected groups: 0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
              <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="Extra attribute column (optional)" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="TxtAnalyseAttr" Tag="AD attribute, e.g. description - then only groups that have a value are reported"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="The snapshot holds, per group" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="20"
                               Text="Name and sAMAccountName · OU placement · members (users, groups, computers) · the groups it is a member of (memberOf) · the extra attribute's value, when one is set above. Check groups or whole OUs in the selection to the left, then export."/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </DockPanel>
          </TabItem>

          <!-- ================= 5: COMPARE (groups or users) ================= -->
          <TabItem Header="Compare">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="RbCmpGroups" GroupName="CmpKind" Style="{StaticResource Seg}" Content="Groups" IsChecked="True"/>
                <RadioButton x:Name="RbCmpUsers"  GroupName="CmpKind" Style="{StaticResource Seg}" Content="Users"/>
              </StackPanel>
              <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnCmpExport" Content="Export comparison" Style="{StaticResource Primary}" MinWidth="190" ToolTip="HTML + CSV + JSON of the rows shown (the filter and Only differences apply)"/>
                    <Button x:Name="BtnCmpExportFmt" Style="{StaticResource Caret}" Background="{StaticResource Green}"><Path Data="{StaticResource IcoCaret}" Stroke="White" StrokeThickness="2.2" Width="12" Height="8" Stretch="Uniform"/></Button>
                  </StackPanel>
                  <TextBlock Text="Read-only - nothing is written to AD. The export holds the rows shown in the table." Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </Border>
              <Grid>
                <!-- Groups -->
                <Grid x:Name="PnlCmpGroups" Visibility="{Binding IsChecked, ElementName=RbCmpGroups, Converter={StaticResource B2V}}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Top" x:Name="TxtCompareCount" Text="Selected groups: 0 (pick 2)" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                      <Expander DockPanel.Dock="Top" Header="Attribute filter" Margin="0,0,0,8">
                        <Grid Margin="0,6,0,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                          <TextBox Grid.Row="0" Grid.Column="0" x:Name="TxtCmpAttr1" Tag="AD-attribute, e.g. name" Margin="0,0,0,4"/>
                          <TextBox Grid.Row="0" Grid.Column="2" x:Name="TxtCmpVal1"  Tag="Value" Margin="0,0,0,4"/>
                          <TextBox Grid.Row="1" Grid.Column="0" x:Name="TxtCmpAttr2" Tag="AD-attribute" Margin="0,0,0,4"/>
                          <TextBox Grid.Row="1" Grid.Column="2" x:Name="TxtCmpVal2"  Tag="Value" Margin="0,0,0,4"/>
                          <TextBox Grid.Row="2" Grid.Column="0" x:Name="TxtCmpAttr3" Tag="AD-attribute"/>
                          <TextBox Grid.Row="2" Grid.Column="2" x:Name="TxtCmpVal3"  Tag="Value"/>
                        </Grid>
                      </Expander>
                      <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Left" x:Name="BtnCompareUncheck" Style="{StaticResource IconBtn}" ToolTip="Clear the selection"><Path Data="{StaticResource IcoNone}" Stroke="#3B4754" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/></Button>
                        <Button x:Name="BtnCompareLoad" Content="Compare selected (2)"/>
                      </DockPanel>
                      <TreeView x:Name="CompareTree" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </DockPanel>
                  </Border>
                  <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                      <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="A" Foreground="#0F4C81" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox   Grid.Column="1" x:Name="TxtCompareAName" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontWeight="SemiBold" Text="(no group selected)"/>
                        <TextBlock Grid.Column="3" Text="B" Foreground="#5B21B6" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox   Grid.Column="4" x:Name="TxtCompareBName" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontWeight="SemiBold" Text="(no group selected)"/>
                      </Grid>
                      <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtCompareAttrFilter" Tag="Filter attribute name, e.g. url"/>
                        <CheckBox Grid.Column="2" x:Name="ChkCompareOnlyDiff" Content="Only differences"/>
                      </Grid>
                      <TextBlock DockPanel.Dock="Bottom" x:Name="TxtCompareResult" Text="Check two groups and click Compare selected." Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                      <DataGrid x:Name="GridGroupCmp" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" RowHeight="NaN">
                        <DataGrid.RowStyle>
                          <Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="differs"><Setter Property="Background" Value="#FDECEC"/></DataTrigger></Style.Triggers></Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Attribute" Binding="{Binding Attribute}" Width="170">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                          </DataGridTextColumn>
                          <DataGridTextColumn Header="Group A" Binding="{Binding ValueA}" Width="*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding ValueA}"/></Style></DataGridTextColumn.ElementStyle>
                          </DataGridTextColumn>
                          <DataGridTextColumn Header="Group B" Binding="{Binding ValueB}" Width="*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding ValueB}"/></Style></DataGridTextColumn.ElementStyle>
                          </DataGridTextColumn>
                          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                        </DataGrid.Columns>
                      </DataGrid>
                    </DockPanel>
                  </Border>
                </Grid>
                <!-- Users -->
                <Grid x:Name="PnlCmpUsers" Visibility="{Binding IsChecked, ElementName=RbCmpUsers, Converter={StaticResource B2V}}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Top" x:Name="TxtUserCompareCount" Text="Selected users: 0 (pick 2)" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                      <TextBox DockPanel.Dock="Top" x:Name="TxtUserFilter" Tag="Filter by name..." Margin="0,0,0,6"/>
                      <Expander DockPanel.Dock="Top" Header="Attribute filter" Margin="0,0,0,8">
                        <Grid Margin="0,6,0,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                          <TextBox Grid.Row="0" Grid.Column="0" x:Name="TxtUsrAttr1" Tag="AD-attribute, e.g. department" Margin="0,0,0,4"/>
                          <TextBox Grid.Row="0" Grid.Column="2" x:Name="TxtUsrVal1"  Tag="Value" Margin="0,0,0,4"/>
                          <TextBox Grid.Row="1" Grid.Column="0" x:Name="TxtUsrAttr2" Tag="AD-attribute" Margin="0,0,0,4"/>
                          <TextBox Grid.Row="1" Grid.Column="2" x:Name="TxtUsrVal2"  Tag="Value" Margin="0,0,0,4"/>
                          <TextBox Grid.Row="2" Grid.Column="0" x:Name="TxtUsrAttr3" Tag="AD-attribute"/>
                          <TextBox Grid.Row="2" Grid.Column="2" x:Name="TxtUsrVal3"  Tag="Value"/>
                        </Grid>
                      </Expander>
                      <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Left" x:Name="BtnUserUncheck" Style="{StaticResource IconBtn}" ToolTip="Clear the selection"><Path Data="{StaticResource IcoNone}" Stroke="#3B4754" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/></Button>
                        <Button x:Name="BtnUserLoad" Content="Compare selected (2)"/>
                      </DockPanel>
                      <TreeView x:Name="UserTree" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </DockPanel>
                  </Border>
                  <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                      <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="A" Foreground="#0F4C81" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox   Grid.Column="1" x:Name="TxtUserAName" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontWeight="SemiBold" Text="(no user selected)"/>
                        <TextBlock Grid.Column="3" Text="B" Foreground="#5B21B6" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox   Grid.Column="4" x:Name="TxtUserBName" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontWeight="SemiBold" Text="(no user selected)"/>
                      </Grid>
                      <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtUserAttrFilter" Tag="Filter attribute name, e.g. department"/>
                        <CheckBox Grid.Column="2" x:Name="ChkUserOnlyDiff" Content="Only differences"/>
                      </Grid>
                      <TextBlock DockPanel.Dock="Bottom" x:Name="TxtUserResult" Text="Check two users and click Compare selected." Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                      <DataGrid x:Name="GridUserCmp" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" RowHeight="NaN">
                        <DataGrid.RowStyle>
                          <Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="differs"><Setter Property="Background" Value="#FDECEC"/></DataTrigger></Style.Triggers></Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Attribute" Binding="{Binding Attribute}" Width="170">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                          </DataGridTextColumn>
                          <DataGridTextColumn Header="User A" Binding="{Binding ValueA}" Width="*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding ValueA}"/></Style></DataGridTextColumn.ElementStyle>
                          </DataGridTextColumn>
                          <DataGridTextColumn Header="User B" Binding="{Binding ValueB}" Width="*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding ValueB}"/></Style></DataGridTextColumn.ElementStyle>
                          </DataGridTextColumn>
                          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                        </DataGrid.Columns>
                      </DataGrid>
                    </DockPanel>
                  </Border>
                </Grid>
              </Grid>
            </DockPanel>
          </TabItem>

          <!-- ================= 6: SNAPSHOTS (export -> compare -> restore) ================= -->
          <TabItem Header="Snapshots">
            <TabControl x:Name="SnapSteps" BorderThickness="0" Background="Transparent" Padding="0" ItemContainerStyle="{StaticResource StepTab}">

              <!-- Step 1: export users -->
              <TabItem>
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="24" Height="24" CornerRadius="12" Background="#1E76BE" Margin="0,0,10,0"><TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel><TextBlock Text="Export users" FontWeight="SemiBold"/><TextBlock Text="before and after the move" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
                  </StackPanel>
                </TabItem.Header>
                <DockPanel>
                  <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnSnapAll" Content="Export users" Style="{StaticResource Primary}" ToolTip="HTML + CSV + JSON"/>
                        <Button x:Name="BtnSnapFmt" Style="{StaticResource Caret}" Background="{StaticResource Green}"><Path Data="{StaticResource IcoCaret}" Stroke="White" StrokeThickness="2.2" Width="12" Height="8" Stretch="Uniform"/></Button>
                      </StackPanel>
                      <TextBlock x:Name="TxtSnapCount" Text="No users loaded yet." FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                  </Border>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                      <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <TextBlock Text="Group by" Style="{StaticResource Lbl}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                          <ComboBox Grid.Column="1" x:Name="CmbSnapGroupBy" SelectedIndex="0"><ComboBoxItem Content="OU"/><ComboBoxItem Content="Department"/><ComboBoxItem Content="Office"/><ComboBoxItem Content="(none)"/></ComboBox>
                          <TextBox Grid.Column="3" x:Name="TxtSnapFilter" Tag="Filter by name..."/>
                        </Grid>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                          <Button x:Name="BtnSnapCheckAll"   Style="{StaticResource IconBtn}" ToolTip="Select all"><Path Data="{StaticResource IcoAll}" Stroke="#3B4754" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/></Button>
                          <Button x:Name="BtnSnapUncheckAll" Style="{StaticResource IconBtn}" ToolTip="Clear the selection"><Path Data="{StaticResource IcoNone}" Stroke="#3B4754" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/></Button>
                          <Button x:Name="BtnSnapExpand"     Style="{StaticResource IconBtn}" ToolTip="Expand all"><Path Data="{StaticResource IcoExpand}" Stroke="#3B4754" StrokeThickness="2" Width="14" Height="10" Stretch="Uniform"/></Button>
                          <Button x:Name="BtnSnapCollapse"   Style="{StaticResource IconBtn}" ToolTip="Collapse all"><Path Data="{StaticResource IcoCollapse}" Stroke="#3B4754" StrokeThickness="2" Width="14" Height="10" Stretch="Uniform"/></Button>
                        </StackPanel>
                        <TreeView x:Name="SnapTree" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                      </DockPanel>
                    </Border>
                    <StackPanel Grid.Column="2">
                      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                          <TextBlock Text="Attribute filter" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBox Grid.Row="0" Grid.Column="0" x:Name="TxtSnapAttr1" Tag="AD-attribute, e.g. title" Margin="0,0,0,4"/>
                            <TextBox Grid.Row="0" Grid.Column="2" x:Name="TxtSnapVal1"  Tag="Value" Margin="0,0,0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="0" x:Name="TxtSnapAttr2" Tag="AD-attribute" Margin="0,0,0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="2" x:Name="TxtSnapVal2"  Tag="Value" Margin="0,0,0,4"/>
                            <TextBox Grid.Row="2" Grid.Column="0" x:Name="TxtSnapAttr3" Tag="AD-attribute"/>
                            <TextBox Grid.Row="2" Grid.Column="2" x:Name="TxtSnapVal3"  Tag="Value"/>
                          </Grid>
                        </StackPanel>
                      </Border>
                      <Border Style="{StaticResource Card}">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="20"
                                   Text="Export once before the move (the OLD snapshot) and once after it (the NEW one). Step 2 compares the two files."/>
                      </Border>
                    </StackPanel>
                  </Grid>
                </DockPanel>
              </TabItem>

              <!-- Step 2: compare snapshots -->
              <TabItem>
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="24" Height="24" CornerRadius="12" Background="#1E76BE" Margin="0,0,10,0"><TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel><TextBlock Text="Compare snapshots" FontWeight="SemiBold"/><TextBlock Text="what changed per user" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
                  </StackPanel>
                </TabItem.Header>
                <DockPanel>
                  <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnDiffAll" Content="Export comparison" Style="{StaticResource Primary}" ToolTip="HTML + CSV + JSON + SVG"/>
                        <Button x:Name="BtnDiffFmt" Style="{StaticResource Caret}" Background="{StaticResource Green}"><Path Data="{StaticResource IcoCaret}" Stroke="White" StrokeThickness="2.2" Width="12" Height="8" Stretch="Uniform"/></Button>
                      </StackPanel>
                      <TextBlock x:Name="TxtDiffCount" Text="No comparison run." FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                  </Border>
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="170"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                      <StackPanel>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0"><TextBlock Text="OLD snapshot (CSV or JSON)" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtOldCsv"/></StackPanel>
                          <Button Grid.Column="1" x:Name="BtnPickOld" Content="Browse..." Style="{StaticResource Ghost}" MinWidth="96" Margin="6,0,0,0" VerticalAlignment="Bottom"/>
                          <StackPanel Grid.Column="3"><TextBlock Text="NEW snapshot (CSV or JSON)" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtNewCsv"/></StackPanel>
                          <Button Grid.Column="4" x:Name="BtnPickNew" Content="Browse..." Style="{StaticResource Ghost}" MinWidth="96" Margin="6,0,0,0" VerticalAlignment="Bottom"/>
                          <Button Grid.Column="6" x:Name="BtnCompareCsv" Content="Compare" MinWidth="140" VerticalAlignment="Bottom"/>
                        </Grid>
                        <Expander Header="Pair renamed groups (find -> replace before comparing)"
                                  ToolTip="Applied to group names on both sides before matching, so a group that was only renamed lines up as unchanged instead of one lost + one gained. Case-insensitive, literal text.">
                          <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"  x:Name="TxtDiffFind1" Tag="Find, e.g. OLD"/>
                            <TextBox Grid.Column="2"  x:Name="TxtDiffRepl1" Tag="Replace, e.g. NEW"/>
                            <TextBox Grid.Column="4"  x:Name="TxtDiffFind2" Tag="Find"/>
                            <TextBox Grid.Column="6"  x:Name="TxtDiffRepl2" Tag="Replace"/>
                            <TextBox Grid.Column="8"  x:Name="TxtDiffFind3" Tag="Find"/>
                            <TextBox Grid.Column="10" x:Name="TxtDiffRepl3" Tag="Replace"/>
                          </Grid>
                        </Expander>
                      </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                      <DataGrid x:Name="GridDiff" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="NaN">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Account"      Binding="{Binding Account}"    Width="110"/>
                          <DataGridTextColumn Header="Name"         Binding="{Binding Name}"       Width="150"/>
                          <DataGridTextColumn Header="Status"       Binding="{Binding Status}"     Width="150"/>
                          <DataGridTextColumn Header="What changed" Binding="{Binding Changes}"    Width="2*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding Changes}"/></Style></DataGridTextColumn.ElementStyle>
                          </DataGridTextColumn>
                          <DataGridTextColumn Header="Grp old"      Binding="{Binding OldGroups}"  Width="60"/>
                          <DataGridTextColumn Header="Grp new"      Binding="{Binding NewGroups}"  Width="60"/>
                          <DataGridTextColumn Header="Lost groups"  Binding="{Binding LostGroups}" Width="*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding LostGroups}"/></Style></DataGridTextColumn.ElementStyle>
                          </DataGridTextColumn>
                        </DataGrid.Columns>
                      </DataGrid>
                    </Border>
                  </Grid>
                </DockPanel>
              </TabItem>

              <!-- Step 3: restore lost groups -->
              <TabItem>
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="24" Height="24" CornerRadius="12" Background="#1E76BE" Margin="0,0,10,0"><TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel><TextBlock Text="Restore lost groups" FontWeight="SemiBold"/><TextBlock Text="add users back to their groups" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
                  </StackPanel>
                </TabItem.Header>
                <DockPanel>
                  <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnRestoreCheck" Content="Check in AD" Style="{StaticResource Ghost}" MinWidth="140" Margin="0,0,10,0"
                                ToolTip="Reads AD without changing anything: Missing - will be added, Already member, or an error."/>
                        <CheckBox x:Name="ChkRestoreWhatIf" Style="{StaticResource WhatIf}" IsChecked="True" Margin="0,0,10,0"/>
                        <Button x:Name="BtnRestoreApply" Content="Add users to their lost groups" Style="{StaticResource Primary}" MinWidth="230"/>
                      </StackPanel>
                      <TextBlock x:Name="TxtRestoreResult" Text="Nothing run yet." Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                  </Border>
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="170"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Text="Comparison file (comparison_*.csv or .json from step 2)" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtRestoreFile"/></StackPanel>
                        <Button Grid.Column="1" x:Name="BtnRestorePick" Content="Browse..." Style="{StaticResource Ghost}" MinWidth="96" Margin="6,0,0,0" VerticalAlignment="Bottom"/>
                        <Button Grid.Column="2" x:Name="BtnRestoreLoad" Content="Load lost groups" MinWidth="160" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                      </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                      <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBox x:Name="TxtRestoreFilter" Width="260" Tag="Filter account, name or group..." Margin="0,0,10,0"/>
                            <Button x:Name="BtnRestoreAll"  Style="{StaticResource IconBtn}" ToolTip="Check all rows"><Path Data="{StaticResource IcoAll}" Stroke="#3B4754" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/></Button>
                            <Button x:Name="BtnRestoreNone" Style="{StaticResource IconBtn}" ToolTip="Uncheck all rows" Margin="0"><Path Data="{StaticResource IcoNone}" Stroke="#3B4754" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/></Button>
                          </StackPanel>
                          <TextBlock x:Name="TxtRestoreCount" Text="No comparison file loaded." Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <DataGrid x:Name="GridRestore" AutoGenerateColumns="False" CanUserAddRows="False">
                          <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Inc." Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="42"/>
                            <DataGridTextColumn Header="Status"     Binding="{Binding Status}"  Width="190" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Account"    Binding="{Binding Account}" Width="130" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Name"       Binding="{Binding Name}"    Width="170" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Lost group" Binding="{Binding Group}"   Width="*"   IsReadOnly="True">
                              <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding GroupDN}"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                          </DataGrid.Columns>
                        </DataGrid>
                      </DockPanel>
                    </Border>
                  </Grid>
                </DockPanel>
              </TabItem>
            </TabControl>
          </TabItem>

          <!-- ================= 7: OU STRUCTURE (export in source, import in target) ================= -->
          <TabItem Header="OU">
            <TabControl x:Name="OuSteps" BorderThickness="0" Background="Transparent" Padding="0" ItemContainerStyle="{StaticResource StepTab}">
              <TabItem>
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="24" Height="24" CornerRadius="12" Background="#1E76BE" Margin="0,0,10,0"><TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel><TextBlock Text="Export OU structure" FontWeight="SemiBold"/><TextBlock Text="run in the source domain" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
                  </StackPanel>
                </TabItem.Header>
                <DockPanel>
                  <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnOuExpFolder" Content="Open folder" Style="{StaticResource Ghost}" Margin="0,0,10,0"/>
                        <Button x:Name="BtnOuExport" Content="Export OU structure" Style="{StaticResource Primary}" MinWidth="190"/>
                      </StackPanel>
                      <TextBlock x:Name="TxtOuExpResult" Text="Nothing exported yet." Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                  </Border>
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="170"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                      <StackPanel>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <StackPanel><TextBlock Text="Root OU - name or full DN" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtOuExpRoot" Tag="e.g. Contoso - or OU=Contoso,OU=Regions,DC=contoso,DC=local"/></StackPanel>
                          <Button Grid.Column="1" x:Name="BtnOuExpBrowse" Content="Browse..." Style="{StaticResource Ghost}" Margin="8,0,0,0" VerticalAlignment="Bottom" ToolTip="Pick the OU in a tree of this domain"/>
                          <Button Grid.Column="2" x:Name="BtnOuExpUseRoot" Content="Use Root" Style="{StaticResource Ghost}" Margin="8,0,0,0" VerticalAlignment="Bottom" ToolTip="Copy the Root (SearchBase) from the top bar"/>
                        </Grid>
                        <CheckBox x:Name="ChkOuExpSubOus" Content="Include all sub-OUs" IsChecked="True" Margin="0,10,0,0"
                                  ToolTip="Checked: the OU and every sub-OU below it, at every level. Cleared: only the OU itself."/>
                        <TextBlock Text="Read-only - nothing in AD is changed. The OU (and its sub-OUs) - name, description, protected flag - are written to a CSV in files\ou-structure. Copy that file to the target domain and import it in step 2." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                      </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                          <RadioButton x:Name="RbOuExpResult" GroupName="OuExpView" Style="{StaticResource Seg}" Content="Result" IsChecked="True"/>
                          <RadioButton x:Name="RbOuExpOutput" GroupName="OuExpView" Style="{StaticResource Seg}" Content="Script output"/>
                        </StackPanel>
                        <Grid>
                          <DataGrid x:Name="GridOuExp" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"
                                    Visibility="{Binding IsChecked, ElementName=RbOuExpResult, Converter={StaticResource B2V}}"/>
                          <TextBox x:Name="TxtOuExpOut" Style="{x:Null}" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                   Background="#0F2233" Foreground="#E5EDF5" BorderThickness="0" FontFamily="Consolas" FontSize="12" Padding="8"
                                   Visibility="{Binding IsChecked, ElementName=RbOuExpOutput, Converter={StaticResource B2V}}"/>
                        </Grid>
                      </DockPanel>
                    </Border>
                  </Grid>
                </DockPanel>
              </TabItem>
              <TabItem>
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="24" Height="24" CornerRadius="12" Background="#1E76BE" Margin="0,0,10,0"><TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel><TextBlock Text="Import OU structure" FontWeight="SemiBold"/><TextBlock Text="run in the target domain" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
                  </StackPanel>
                </TabItem.Header>
                <DockPanel>
                  <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnOuImpFolder" Content="Open folder" Style="{StaticResource Ghost}" Margin="0,0,10,0"/>
                        <CheckBox x:Name="ChkOuImpWhatIf" Style="{StaticResource WhatIf}" IsChecked="True" Margin="0,0,10,0"/>
                        <Button x:Name="BtnOuImport" Content="Create OUs" Style="{StaticResource Primary}"/>
                      </StackPanel>
                      <TextBlock x:Name="TxtOuImpResult" Text="Nothing run yet." Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                  </Border>
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="170"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                      <StackPanel>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <StackPanel><TextBlock Text="CSV file from step 1 (OU-Structure_*.csv)" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtOuImpFile"/></StackPanel>
                          <Button Grid.Column="1" x:Name="BtnOuImpPick" Content="Browse..." Style="{StaticResource Ghost}" MinWidth="96" Margin="6,0,0,0" VerticalAlignment="Bottom"/>
                          <Button Grid.Column="2" x:Name="BtnOuImpLoad" Content="Load" MinWidth="110" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                        </Grid>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <StackPanel><TextBlock Text="Create under (parent DN)" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtOuImpParent" Tag="Empty = the domain root"/></StackPanel>
                          <Button Grid.Column="1" x:Name="BtnOuImpParentBrowse" Content="Browse..." Style="{StaticResource Ghost}" MinWidth="96" Margin="6,0,0,0" VerticalAlignment="Bottom" ToolTip="Pick the OU (or the domain root) in a tree of this domain"/>
                        </Grid>
                        <TextBlock Text="OUs that already exist are skipped, so it can be run again. Description and 'Protect object from accidental deletion' are copied. Only OUs are created - no users, groups, computers or GPO links." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                      </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                      <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <RadioButton x:Name="RbOuImpResult" GroupName="OuImpView" Style="{StaticResource Seg}" Content="Result" IsChecked="True"/>
                            <RadioButton x:Name="RbOuImpOutput" GroupName="OuImpView" Style="{StaticResource Seg}" Content="Script output"/>
                          </StackPanel>
                          <TextBlock x:Name="TxtOuImpCount" Text="No file loaded." Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Grid>
                          <DataGrid x:Name="GridOuImp" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"
                                    Visibility="{Binding IsChecked, ElementName=RbOuImpResult, Converter={StaticResource B2V}}"/>
                          <TextBox x:Name="TxtOuImpOut" Style="{x:Null}" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                   Background="#0F2233" Foreground="#E5EDF5" BorderThickness="0" FontFamily="Consolas" FontSize="12" Padding="8"
                                   Visibility="{Binding IsChecked, ElementName=RbOuImpOutput, Converter={StaticResource B2V}}"/>
                        </Grid>
                      </DockPanel>
                    </Border>
                  </Grid>
                </DockPanel>
              </TabItem>
            </TabControl>
          </TabItem>

          <!-- ================= 8: SCHEMA ATTRIBUTES (export in source, import in target) ================= -->
          <TabItem Header="Schema">
            <TabControl x:Name="SchSteps" BorderThickness="0" Background="Transparent" Padding="0" ItemContainerStyle="{StaticResource StepTab}">
              <TabItem>
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="24" Height="24" CornerRadius="12" Background="#1E76BE" Margin="0,0,10,0"><TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel><TextBlock Text="Export schema attributes" FontWeight="SemiBold"/><TextBlock Text="run in the source forest" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
                  </StackPanel>
                </TabItem.Header>
                <DockPanel>
                  <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnSchExpFolder" Content="Open folder" Style="{StaticResource Ghost}" Margin="0,0,10,0"/>
                        <Button x:Name="BtnSchExport" Content="Export schema" Style="{StaticResource Primary}"/>
                      </StackPanel>
                      <TextBlock x:Name="TxtSchExpResult" Text="Nothing exported yet." Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                  </Border>
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="170"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                          <TextBlock Text="Attribute list from" Style="{StaticResource Lbl}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                          <RadioButton x:Name="RbSchFromUser" GroupName="SchSource" Style="{StaticResource Seg}" Content="A user" IsChecked="True"/>
                          <RadioButton x:Name="RbSchFromCsv"  GroupName="SchSource" Style="{StaticResource Seg}" Content="A CSV file"/>
                        </StackPanel>
                        <StackPanel x:Name="PnlSchUser" Visibility="{Binding IsChecked, ElementName=RbSchFromUser, Converter={StaticResource B2V}}">
                          <TextBlock Text="User (sAMAccountName) - every attribute a user object can have is read from it" Style="{StaticResource Lbl}"/>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSchUser" Tag="e.g. jdoe"/>
                            <Button Grid.Column="1" x:Name="BtnSchUserBrowse" Content="Browse..." Style="{StaticResource Ghost}" MinWidth="96" Margin="6,0,0,0" ToolTip="Find the user in a tree of this domain, or search by name"/>
                          </Grid>
                        </StackPanel>
                        <Grid x:Name="PnlSchCsv" Visibility="{Binding IsChecked, ElementName=RbSchFromCsv, Converter={StaticResource B2V}}">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <StackPanel><TextBlock Text="CSV with a column Attribute (and optionally InUse), ; separated" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtSchCsv"/></StackPanel>
                          <Button Grid.Column="1" x:Name="BtnSchCsvPick" Content="Browse..." Style="{StaticResource Ghost}" MinWidth="96" Margin="6,0,0,0" VerticalAlignment="Bottom"/>
                        </Grid>
                        <CheckBox x:Name="ChkSchOnlyUsed" Content="Only attributes that have a value" Margin="0,10,0,0"
                                  ToolTip="From a user: only the attributes that user has a value in. From a CSV: rows where InUse is True."/>
                        <TextBlock Text="Read-only - the schema is only read. The JSON holds schema definitions (OID, syntax, schemaIDGUID, classes), not user data. Saved to files\schema-attributes." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                      </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                          <RadioButton x:Name="RbSchExpResult" GroupName="SchExpView" Style="{StaticResource Seg}" Content="Result" IsChecked="True"/>
                          <RadioButton x:Name="RbSchExpOutput" GroupName="SchExpView" Style="{StaticResource Seg}" Content="Script output"/>
                        </StackPanel>
                        <Grid>
                          <DataGrid x:Name="GridSchExp" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"
                                    Visibility="{Binding IsChecked, ElementName=RbSchExpResult, Converter={StaticResource B2V}}"/>
                          <TextBox x:Name="TxtSchExpOut" Style="{x:Null}" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                   Background="#0F2233" Foreground="#E5EDF5" BorderThickness="0" FontFamily="Consolas" FontSize="12" Padding="8"
                                   Visibility="{Binding IsChecked, ElementName=RbSchExpOutput, Converter={StaticResource B2V}}"/>
                        </Grid>
                      </DockPanel>
                    </Border>
                  </Grid>
                </DockPanel>
              </TabItem>
              <TabItem>
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="24" Height="24" CornerRadius="12" Background="#1E76BE" Margin="0,0,10,0"><TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel><TextBlock Text="Import schema attributes" FontWeight="SemiBold"/><TextBlock Text="run in the target forest" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
                  </StackPanel>
                </TabItem.Header>
                <DockPanel>
                  <Border DockPanel.Dock="Top" Background="#FDE8E8" BorderBrush="#F2B8B8" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,12">
                    <TextBlock TextWrapping="Wrap" Foreground="#7F1D1D" FontWeight="SemiBold"
                               Text="Schema changes are permanent - attributes and classes can be deactivated but never deleted. Run with WhatIf first, take a snapshot or backup of the target domain controller, and run as a member of Schema Admins. Changes are written to the schema master."/>
                  </Border>
                  <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnSchImpFolder" Content="Open folder" Style="{StaticResource Ghost}" Margin="0,0,10,0"/>
                        <CheckBox x:Name="ChkSchImpWhatIf" Style="{StaticResource WhatIf}" IsChecked="True" Margin="0,0,10,0"/>
                        <Button x:Name="BtnSchImport" Content="Extend schema" Style="{StaticResource Primary}"/>
                      </StackPanel>
                      <TextBlock x:Name="TxtSchImpResult" Text="Nothing run yet." Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                  </Border>
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="170"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                      <StackPanel>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <StackPanel><TextBlock Text="JSON file from step 1 (SchemaAttributes_*.json)" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtSchImpFile"/></StackPanel>
                          <Button Grid.Column="1" x:Name="BtnSchImpPick" Content="Browse..." Style="{StaticResource Ghost}" MinWidth="96" Margin="6,0,0,0" VerticalAlignment="Bottom"/>
                          <Button Grid.Column="2" x:Name="BtnSchImpLoad" Content="Load" MinWidth="110" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                        </Grid>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <StackPanel><TextBlock Text="Only these attributes (optional)" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtSchOnly" Tag="lDAPDisplayName, comma separated - empty = every attribute in the file"/></StackPanel>
                          <CheckBox Grid.Column="2" x:Name="ChkSchExclExchange" Content="Skip Exchange attributes and classes" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                      <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <RadioButton x:Name="RbSchImpResult" GroupName="SchImpView" Style="{StaticResource Seg}" Content="Result" IsChecked="True"/>
                            <RadioButton x:Name="RbSchImpOutput" GroupName="SchImpView" Style="{StaticResource Seg}" Content="Script output"/>
                          </StackPanel>
                          <TextBlock x:Name="TxtSchImpCount" Text="No file loaded." Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Grid>
                          <DataGrid x:Name="GridSchImp" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"
                                    Visibility="{Binding IsChecked, ElementName=RbSchImpResult, Converter={StaticResource B2V}}"/>
                          <TextBox x:Name="TxtSchImpOut" Style="{x:Null}" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                   Background="#0F2233" Foreground="#E5EDF5" BorderThickness="0" FontFamily="Consolas" FontSize="12" Padding="8"
                                   Visibility="{Binding IsChecked, ElementName=RbSchImpOutput, Converter={StaticResource B2V}}"/>
                        </Grid>
                      </DockPanel>
                    </Border>
                  </Grid>
                </DockPanel>
              </TabItem>
            </TabControl>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
